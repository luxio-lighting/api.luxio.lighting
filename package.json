{
  "name": "@luxio-lighting/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "postinstall": "node tools/materialize-dependencies.mjs"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "@fastify/cors": "^11.0.0",
    "mongodb": "^6.20.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "@types/node": "^24.0.0",
    "mongodb-memory-server": "^11.3.0"
  }
}
